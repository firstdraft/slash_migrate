<!DOCTYPE html>
<html>
<head>
  <title>slash_migrate</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%# Self-contained styling + scripts. The engine deliberately does not depend
      on the host app's asset pipeline; JS and CSS are served by the engine
      itself (see AssetsController). Task 5 swaps this inline CSS for a
      precompiled Tailwind + daisyUI build served the same way. %>
  <style>
    :root { --bg:#f8fafc; --panel:#fff; --border:#e2e8f0; --ink:#0f172a; --muted:#64748b; --accent:#4f46e5; --warn:#b45309; --warnbg:#fffbeb; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--ink);
           font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
    header.sm-nav { background:var(--ink); color:#fff; padding:.75rem 1.25rem; display:flex; align-items:center; gap:1.25rem; }
    header.sm-nav a { color:#fff; text-decoration:none; font-weight:600; }
    header.sm-nav .sm-brand { font-size:1.05rem; }
    header.sm-nav .sm-tag { color:#94a3b8; font-size:.8rem; margin-right:auto; }
    header.sm-nav .sm-navlink { font-size:.85rem; color:#c7d2fe; }
    main { max-width: 1040px; margin: 1.5rem auto; padding: 0 1.25rem; }
    h1 { font-size:1.4rem; margin:.25rem 0 1rem; }
    h2 { font-size:1.05rem; margin:1.5rem 0 .5rem; }
    .sm-page-head { display:flex; justify-content:space-between; align-items:baseline; }
    .sm-panel { background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:1rem 1.25rem; }
    table { width:100%; border-collapse:collapse; font-size:.9rem; }
    th, td { text-align:left; padding:.5rem .6rem; border-bottom:1px solid var(--border); }
    th { color:var(--muted); font-weight:600; font-size:.78rem; text-transform:uppercase; letter-spacing:.03em; }
    tr:last-child td { border-bottom:none; }
    a.sm-link { color:var(--accent); text-decoration:none; font-weight:600; }
    a.sm-link:hover { text-decoration:underline; }
    code { background:#f1f5f9; padding:.1rem .35rem; border-radius:4px; font-size:.85em; }
    .sm-badge { display:inline-block; font-size:.72rem; padding:.1rem .45rem; border-radius:999px; background:#eef2ff; color:var(--accent); }
    .sm-badge-pending { background:var(--warnbg); color:var(--warn); }
    .sm-muted { color:var(--muted); }
    .sm-empty { color:var(--muted); padding:2rem 0; }

    /* form + preview */
    .sm-cols { display:grid; grid-template-columns: 1fr 1fr; gap:1rem; align-items:start; }
    .sm-label { display:block; font-size:.78rem; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:.03em; margin-bottom:.3rem; }
    .sm-input { font-size:.9rem; padding:.45rem .55rem; border:1px solid var(--border); border-radius:7px; background:#fff; color:var(--ink); }
    input.sm-input { width:100%; }
    .sm-row { display:flex; gap:.4rem; align-items:center; margin-bottom:.5rem; flex-wrap:wrap; border:1px solid var(--border); border-radius:8px; padding:.4rem; background:#fbfcfe; }
    .sm-row-name { flex:1 1 120px; min-width:100px; }
    .sm-row-default { flex:1 1 90px; min-width:80px; }
    .sm-row-type, .sm-row-null, .sm-row-index { flex:0 0 auto; }
    select.sm-input { padding:.45rem .4rem; }
    .sm-btn { background:var(--accent); color:#fff; border:0; border-radius:7px; padding:.5rem .9rem; font-weight:600; font-size:.9rem; cursor:pointer; }
    .sm-btn-ghost { background:#eef2ff; color:var(--accent); border:0; border-radius:7px; padding:.4rem .7rem; font-weight:600; font-size:.85rem; cursor:pointer; }
    .sm-btn-ghost:disabled { opacity:.45; cursor:not-allowed; }
    .sm-icon-btn { background:transparent; border:1px solid var(--border); color:var(--muted); border-radius:7px; width:32px; height:32px; cursor:pointer; font-size:1rem; line-height:1; }
    .sm-code { background:#0f172a; color:#e2e8f0; padding:.8rem .9rem; border-radius:8px; font-size:.82rem; overflow-x:auto; white-space:pre; margin:.2rem 0 1rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    .sm-code.sm-cmd { background:#1e293b; color:#a5b4fc; }
    .sm-note { padding:.6rem .8rem; border-radius:8px; font-size:.85rem; }
    .sm-note-warn { background:var(--warnbg); color:var(--warn); border:1px solid #fde68a; }
    .sm-flash { background:#ecfdf5; color:#047857; border:1px solid #a7f3d0; padding:.6rem .9rem; border-radius:8px; margin-bottom:1rem; font-size:.9rem; }
    .sm-flash-alert { background:var(--warnbg); color:var(--warn); border-color:#fde68a; }
    .sm-preview-panel { position:sticky; top:1rem; }
  </style>

  <script src="<%= asset_file_path(name: "turbo.min.js") %>" defer></script>
  <script src="<%= asset_file_path(name: "stimulus.min.js") %>" defer></script>
  <script src="<%= asset_file_path(name: "controllers.js") %>" defer></script>
</head>
<body>
  <header class="sm-nav">
    <%= link_to "slash_migrate", root_path, class: "sm-brand" %>
    <span class="sm-tag">development-only migration GUI</span>
    <%= link_to "Tables", root_path, class: "sm-navlink" %>
    <%= link_to "New model", new_model_path, class: "sm-navlink" %>
    <%= link_to "Migrations", migrations_path, class: "sm-navlink" %>
  </header>

  <main>
    <% if flash[:notice] %><div class="sm-flash"><%= flash[:notice] %></div><% end %>
    <% if flash[:alert] %><div class="sm-flash sm-flash-alert"><%= flash[:alert] %></div><% end %>
    <%= yield %>
  </main>
</body>
</html>
