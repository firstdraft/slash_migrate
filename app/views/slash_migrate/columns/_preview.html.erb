<% if @error.present? %>
  <%= render layout: "slash_migrate/shared/callout", locals: {kind: "warn", title: "Can't build that yet"} do %><%= @error %><% end %>
<% elsif !@migration.any? %>
  <p class="preview-hint"><%= @hint || "Add a column to see the migration it will generate." %></p>
<% else %>
  <% @migration.references_with_id_suffix.each do |column| %>
    <%= render layout: "slash_migrate/shared/callout", locals: {kind: "warn", title: "References don't take an _id"} do %>
      A <span class="mono">references</span> column adds <span class="mono">_id</span> for you, so
      <span class="mono"><%= column %></span> would make a <span class="mono"><%= column %>_id</span> column.
      Name it <span class="mono"><%= column.sub(/_id\z/i, "") %></span> instead.
    <% end %>
  <% end %>

  <%= render "slash_migrate/shared/code_file",
        path: "db/migrate/", name: @migration.migration_filename.sub(/\A\d+_/, ""), kind: "migration", timestamped: true,
        source: @migration.migration_source,
        foot: "db:rollback undoes this by removing the new column(s).", foot_kind: "info" %>
<% end %>
